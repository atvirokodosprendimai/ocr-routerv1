package views

import "fmt"
import "github.com/atvirokodosprendimai/ocr-router/internal/core"

// Overview is the landing page: live counters, the job table and the worker
// table, all patched in over one SSE stream.
templ Overview(d Dashboard) {
	@Layout("Overview", `{}`) {
		<div data-init="@get('/admin/stream')"></div>
		@Stats(d)
		@Jobs(d)
		@Workers(d)
	}
}

// Stats is a live fragment. Its root id is the morph target, so it must be
// stable and must exist in the first paint — a fragment cannot be patched into
// existence, only over something already in the document.
templ Stats(d Dashboard) {
	<section id="stats">
		<h2>Now</h2>
		<div class="cards">
			@stat("queued", d.Counts[core.JobQueued])
			@stat("processing", d.Counts[core.JobProcessing])
			@stat("done", d.Counts[core.JobDone])
			@stat("delivered", d.Counts[core.JobDelivered])
			@stat("dead", d.Counts[core.JobDead])
			@stat("expired", d.Counts[core.JobExpired])
			<div class="card">
				<div class="n">{ fmt.Sprint(d.ResultsInMemory) }</div>
				<div class="k">results held</div>
			</div>
		</div>
	</section>
}

templ stat(name string, n int) {
	<div class="card">
		<div class="n">{ fmt.Sprint(n) }</div>
		<div class="k">{ name }</div>
	</div>
}

// Jobs lists recent work.
templ Jobs(d Dashboard) {
	<section id="jobs">
		<h2>Recent jobs</h2>
		if len(d.Jobs) == 0 {
			<p class="empty">No jobs yet. Upload one with a client token to see it here.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Job</th><th>Customer</th><th>Service</th><th>Stage</th>
						<th>State</th><th class="num">Units</th><th class="num">Cost</th><th>Detail</th>
					</tr>
				</thead>
				<tbody>
					for _, j := range d.Jobs {
						<tr>
							<td class="muted">{ shortID(j.Job.ID) }</td>
							<td>{ d.Emails[j.Job.UserID] }</td>
							<td>{ j.Job.Label }</td>
							<td class="num">{ j.StageLabel }</td>
							<td><span class={ "tag", string(j.Job.State) }>{ string(j.Job.State) }</span></td>
							<td class="num">{ fmt.Sprint(j.Job.Units) }</td>
							<td class="num">{ fmt.Sprint(j.Job.AccruedCredits) }</td>
							// Stored text — a worker's stderr — as a TEXT NODE. It must
							// never reach a data-* attribute: `@word(` inside a compiled
							// expression throws and silently disables the element.
							<td class="muted">{ j.Job.LastError }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

// Workers shows which services currently have someone serving them.
//
// This is the view of the silent failure: a label with a queue and no worker.
templ Workers(d Dashboard) {
	<section id="workers">
		<h2>Services</h2>
		if len(d.Services) == 0 {
			<p class="empty">
				No workers are connected. Uploads will be refused until one starts.
			</p>
		} else {
			<table>
				<thead>
					<tr><th>Label</th><th class="num">Workers</th><th class="num">Queued</th><th class="num">Rate</th><th>Mode</th><th>Health</th></tr>
				</thead>
				<tbody>
					for _, s := range d.Services {
						<tr>
							<td>{ s.Label }</td>
							<td class="num">{ fmt.Sprint(s.Workers) }</td>
							<td class="num">{ fmt.Sprint(s.Queued) }</td>
							<td class="num">{ fmt.Sprint(s.Rate) }</td>
							if s.Raw {
								<td><span class="tag raw">raw</span></td>
							} else {
								<td><span class="muted">units</span></td>
							}
							if s.Workers == 0 && s.Queued > 0 {
								<td><span class="tag dead">no worker, { fmt.Sprint(s.Queued) } waiting</span></td>
							} else if s.Workers == 0 {
								<td><span class="tag expired">no worker</span></td>
							} else {
								<td><span class="tag done">serving</span></td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

// Users is the customer administration page.
templ Users(d Dashboard) {
	@Layout("Customers", `{"newEmail":"","newRole":"client"}`) {
		<section>
			<h2>Create a customer</h2>
			// ⚠ NO <form>. Each input is bound individually, and the suffixes are
			// KEBAB-CASE: `data-bind:new-email` binds the signal `newEmail`.
			// Writing `data-bind:newEmail` would bind `newemail` instead — a
			// different signal, with nothing reporting the mistake.
			<div class="row">
				<div>
					<label for="new-email">Email address</label>
					<input id="new-email" type="email" data-bind:new-email placeholder="customer@example.com"/>
				</div>
				<div>
					<label for="new-role">Role</label>
					<select id="new-role" data-bind:new-role>
						<option value="client">client</option>
						<option value="worker">worker</option>
						<option value="admin">admin</option>
					</select>
				</div>
				<button data-on:click="@post('/admin/users')" data-indicator:creating>Create</button>
				<span class="spin" data-show="$creating">Creating…</span>
			</div>
			<div id="create-result"></div>
		</section>
		@UserTable(d)
	}
}

// UserTable is patched in by id after any change.
//
// Seven columns, matching the colspan on the credit row. Email and role share
// one cell because neither is editable and splitting them wastes the width the
// number inputs need.
//
// ⚠ EMAIL AND ROLE ARE READ-ONLY BY DECISION, not by omission (ADR-0004 §5). The
// email is the login identity and the unique key; a token carries its OWN role
// independent of its user's, so a role control would not demote that user's
// tokens however much it looked like it did. Changing a role means revoking and
// re-minting, which the token list supports.
//
// ⚠ THE CREDIT CONTROL SAYS "ADJUST", NEVER "SET". A box labelled Credits beside
// a balance of 500 reads as the current value, and an operator typing 500
// meaning "make it 500" would add 500. The balance is a ledger: every movement
// needs an entry, so there is no set-to control anywhere in this system.
//
// ⚠ DEACTIVATION STOPS EVERY TOKEN the customer holds, at once. ADR-0001 called
// it the blunt instrument, and the button carries that in its title attribute —
// a control whose consequence is invisible is one that gets clicked by mistake.
//
// ⚠ EVERY ROW'S INPUTS ARE NAMESPACED PER CUSTOMER — see rowsignals.go. These
// were once plain `data-bind:credit-delta`, which made all rows share ONE box:
// datastar signals are global and flattened page-wide, so typing a credit
// adjustment for one customer typed it for every customer, and each row showed
// whatever value rendered last rather than its own.
//
// ⚠ THE FLAT SIGNALS BELOW ARE SUBMIT SCRATCH SPACE, declared here so a handler
// never reads a missing field. A row's Save copies its own values into them and
// posts; the per-row namespace is `_`-prefixed and never leaves the browser.
templ UserTable(d Dashboard) {
	<section
		id="user-table"
		data-signals="{bufferLimit: 0, priority: 0, jobTtl: 0, creditDelta: 0, creditReason: ''}"
	>
		<h2>Customers</h2>
		if len(d.Users) == 0 {
			<p class="empty">No customers yet.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Customer</th><th class="num">Credits</th>
						<th class="num">Buffer</th><th class="num">Priority</th>
						<th class="num">TTL (s)</th><th>State</th><th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range d.Users {
						<tr>
							<td>
								{ u.Email }
								<br/>
								<span class="muted">{ string(u.Role) }</span>
							</td>
							<td class="num">
								{ fmt.Sprint(u.Credits) }
							</td>
							<td class="num">
								<input
									type="number"
									min="1"
									aria-label={ "Buffer limit for " + u.Email }
									value={ fmt.Sprint(u.BufferLimit) }
									data-bind={ rowBind(u.ID, "bufferLimit") }
								/>
							</td>
							<td class="num">
								<input
									type="number"
									aria-label={ "Priority for " + u.Email }
									value={ fmt.Sprint(u.Priority) }
									data-bind={ rowBind(u.ID, "priority") }
								/>
							</td>
							<td class="num">
								<input
									type="number"
									min="0"
									aria-label={ "Job TTL in seconds for " + u.Email }
									value={ fmt.Sprint(u.JobTTLSecs) }
									data-bind={ rowBind(u.ID, "jobTtl") }
								/>
							</td>
							<td>
								if u.Active {
									<span class="tag done">active</span>
								} else {
									<span class="tag dead">disabled</span>
								}
							</td>
							<td class="row-actions">
								<button
									data-on:click={ rowSubmit(u.ID, fmt.Sprintf("/admin/users/%s/settings", u.ID), "bufferLimit", "priority", "jobTtl") }
								>Save</button>
								<button
									class="secondary"
									data-on:click={ fmt.Sprintf("@get('/admin/users/%s/tokens')", u.ID) }
								>Tokens</button>
								<button
									class="secondary"
									data-on:click={ fmt.Sprintf("@post('/admin/users/%s/tokens')", u.ID) }
								>Mint</button>
								<button
									class="secondary"
									title="Stops every token this customer holds, immediately"
									data-on:click={ fmt.Sprintf("@post('/admin/users/%s/active')", u.ID) }
								>
									if u.Active {
										Disable
									} else {
										Enable
									}
								</button>
							</td>
						</tr>
						<tr class="credit-row">
							<td colspan="7">
								<div class="credit-adjust">
									<span class="muted">Adjust credits</span>
									<input
										type="number"
										aria-label={ "Credit adjustment for " + u.Email }
										placeholder="+50 or -20"
										data-bind={ rowBind(u.ID, "creditDelta") }
									/>
									<input
										type="text"
										aria-label={ "Reason for the credit adjustment to " + u.Email }
										placeholder="reason (required)"
										data-bind={ rowBind(u.ID, "creditReason") }
									/>
									<button
										class="secondary"
										data-on:click={ rowSubmit(u.ID, fmt.Sprintf("/admin/users/%s/credits", u.ID), "creditDelta", "creditReason") }
									>Adjust</button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

// TokenOnce shows a freshly minted token.
//
// The plaintext exists only in this response: the router keeps a hash and cannot
// produce it again. Saying so here is the difference between an operator saving
// it and an operator losing access.
templ TokenOnce(token string) {
	<div id="create-result">
		<p class="muted">Copy this now — it is shown once and is stored only as a hash.</p>
		<p class="token">{ token }</p>
	</div>
}

// Tokens lists one user's tokens, with a revoke control on each live one.
//
// ⚠ IT SHOWS NO SECRET AND CANNOT. The router keeps only a SHA-256 and the
// plaintext is returned exactly once at minting — so this table identifies a
// token by its id, its label and when it was last used, which is what an
// operator actually needs to decide whether to revoke it.
//
// `Last used` is the column that earns the screen: it is how you tell a live
// integration from a credential somebody minted for a laptop two jobs ago and
// never cleaned up. "never" is a real and common answer.
templ Tokens(l TokenList) {
	<div id="create-result">
		<section class="tokens">
			<h3>Tokens for { l.Email }</h3>
			if len(l.Tokens) == 0 {
				<p class="empty">This customer holds no tokens.</p>
			} else {
				<table>
					<thead>
						<tr>
							<th>ID</th><th>Label</th><th>Role</th>
							<th>Created</th><th>Last used</th><th>State</th><th></th>
						</tr>
					</thead>
					<tbody>
						for _, t := range l.Tokens {
							<tr>
								<td class="mono">{ shortID(t.Token.ID) }</td>
								<td>
									if t.Token.Label == "" {
										<span class="muted">—</span>
									} else {
										{ t.Token.Label }
									}
								</td>
								<td>{ string(t.Token.Role) }</td>
								<td class="muted">{ t.Created }</td>
								<td class="muted">{ t.LastSeen }</td>
								<td>
									if t.Token.Revoked {
										<span class="tag dead">revoked</span>
									} else {
										<span class="tag done">active</span>
									}
								</td>
								<td>
									if !t.Token.Revoked {
										<button
											class="secondary"
											data-on:click={ fmt.Sprintf("@post('/admin/tokens/%s/revoke')", t.Token.ID) }
										>Revoke</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				<p class="muted">
					Revoking is immediate and cannot be undone. The row is kept so an audit can
					still see the token existed.
				</p>
			}
		</section>
	</div>
}

// CreateError re-renders the form's error inline, with a 200.
templ CreateError(msg string) {
	<div id="create-result">
		<p class="error">{ msg }</p>
	</div>
}

// Services is the rate administration page.
templ Services(d Dashboard) {
	@Layout("Services", `{"rateLabel":"","rateValue":"1","rateRaw":false}`) {
		<section>
			<h2>Set a price</h2>
			<p class="muted">
				A service with no explicit rate costs 1 credit per output unit. Rates are
				administered here and are never taken from a worker: a worker runs on a host
				you do not control and must not be able to set what customers are charged.
			</p>
			<div class="row">
				<div>
					<label for="rate-label">Service label</label>
					<input id="rate-label" data-bind:rate-label placeholder="ocr"/>
				</div>
				<div>
					<label for="rate-value">Credits per unit</label>
					<input id="rate-value" type="number" min="0" data-bind:rate-value/>
				</div>
				<div>
					<label for="rate-raw">Raw output</label>
					<input id="rate-raw" type="checkbox" data-bind:rate-raw/>
					<span class="muted">Bytes through unchanged, billed a flat 1 credit per job.</span>
				</div>
				<button data-on:click="@post('/admin/rates')" data-indicator:saving>Save</button>
				<span class="spin" data-show="$saving">Saving…</span>
			</div>
			<div id="rate-result"></div>
		</section>
		@Workers(d)
	}
}

// RateSaved confirms a rate change.
//
// It names the MODE as well as the number, because the two together are the
// price: "1 credit per unit" and "a flat 1 credit per job" are different
// statements that would otherwise render identically.
templ RateSaved(label string, rate int, raw bool) {
	<div id="rate-result">
		if raw {
			<p class="muted">{ fmt.Sprintf("%s is a raw service: bytes through unchanged, a flat 1 credit per job.", label) }</p>
		} else {
			<p class="muted">{ fmt.Sprintf("%s now costs %d credit(s) per unit.", label, rate) }</p>
		}
	</div>
}

func shortID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}
