package views

// Layout is the shell every admin page renders inside.
//
// ⚠ DATASTAR v1 RULES THAT BIND EVERY VIEW IN THIS PACKAGE. Each of these fails
// SILENTLY when broken — no console error, no failed request, the page simply
// does nothing:
//
//   - `data-init`, never `data-on-load`. The latter does not exist in v1 and is
//     the single most common thing a model writes from memory.
//   - DOM events take a COLON: `data-on:click`. The six hyphenated `data-on-*`
//     names are separate attributes and are not used here.
//   - Attribute suffixes are KEBAB-CASE. HTML lower-cases attribute names, so
//     `data-bind:newUserEmail` silently binds `newuseremail` — a different
//     signal from the one declared. Every binding here is kebab.
//   - No `<form>` tags. Inputs are bound individually.
//   - Signals are GLOBAL and every unprefixed one ships to the backend on every
//     action, so the layout declares only layout-level signals.
//
// ⚠ And the one that is not about syntax: `data-signals` is COMPILED AS
// JAVASCRIPT, so stored text containing `@word(` throws inside the expression
// compiler and every later attribute on that element stops running. No view here
// interpolates stored text into a `data-*` attribute; it goes in a text node.
templ Layout(title string, signals string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — ocr-router</title>
			// ⚠ SERVED BY THIS BINARY, never from a CDN. See assets.go: a
			// self-hosted admin console that fetches its own JavaScript from a
			// third party is dead without egress, leaks its usage, and puts a
			// remote host inside the page that mints API tokens.
			<script type="module" src="/admin/assets/datastar.js"></script>
			<link rel="stylesheet" href={ stylesheetHref() }/>
		</head>
		<body data-signals={ signals }>
			<a class="skip" href="#main">Skip to content</a>
			<header>
				<h1>ocr-router</h1>
				// ⚠ `aria-current` is DERIVED FROM `title`, which is the only thing
				// this component knows about which page it is rendering. app.css has
				// styled `nav a[aria-current="page"]` since the dashboard shipped and
				// nothing ever emitted a usable value — a dead selector, and an
				// operator with no indication of where they were.
				//
				// The coupling to a display string is the cost of not changing three
				// call sites and the signature; TestTheCurrentSectionIsMarked pins all
				// three titles, so a typo unmarks a page loudly rather than silently.
				//
				// ⚠ SPREAD ATTRIBUTES, never `aria-current={ templ.KV(…) }` — see
				// currentPage in attrs.go for what that spelling actually renders.
				<nav aria-label="Sections">
					<a href="/admin" { currentPage(title == "Overview")... }>Overview</a>
					<a href="/admin/users" { currentPage(title == "Customers")... }>Customers</a>
					<a href="/admin/services" { currentPage(title == "Services")... }>Services</a>
				</nav>
				// ⚠ NOT A <form>, and the first attempt here was one — caught by
				// TestNoFormTags, which is the house rule asserted across every view.
				// The login page's plain form is exempt because it is not rendered
				// through this layout; that is not a licence to add another.
				//
				// So: a datastar action, and `doLogout` answers it with an SSE
				// redirect (`sse.Redirect`) rather than a 303. A 303 here would be
				// followed by datastar's own fetch, which would then try to parse the
				// login PAGE as an event stream and fail silently — the operator's
				// session gone and the screen unchanged.
				//
				// POST rather than a link because doLogout revokes server-side, and a
				// GET logout is reachable by any prefetch or crawler.
				<button
					class="secondary signout"
					title="Ends this session everywhere, including other tabs"
					data-on:click="@post('/admin/logout')"
				>Sign out</button>
			</header>
			<main id="main">
				{ children... }
			</main>
		</body>
	</html>
}
