package views

// Layout is the shell every admin page renders inside.
//
// ⚠ DATASTAR v1 RULES THAT BIND EVERY VIEW IN THIS PACKAGE. Each of these fails
// SILENTLY when broken — no console error, no failed request, the page simply
// does nothing:
//
//   - `data-init`, never `data-on-load`. The latter does not exist in v1 and is
//     the single most common thing a model writes from memory.
//   - DOM events take a COLON: `data-on:click`. The six hyphenated `data-on-*`
//     names are separate attributes and are not used here.
//   - Attribute suffixes are KEBAB-CASE. HTML lower-cases attribute names, so
//     `data-bind:newUserEmail` silently binds `newuseremail` — a different
//     signal from the one declared. Every binding here is kebab.
//   - No `<form>` tags. Inputs are bound individually.
//   - Signals are GLOBAL and every unprefixed one ships to the backend on every
//     action, so the layout declares only layout-level signals.
//
// ⚠ And the one that is not about syntax: `data-signals` is COMPILED AS
// JAVASCRIPT, so stored text containing `@word(` throws inside the expression
// compiler and every later attribute on that element stops running. No view here
// interpolates stored text into a `data-*` attribute; it goes in a text node.
templ Layout(title string, signals string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — ocr-router</title>
			// ⚠ SERVED BY THIS BINARY, never from a CDN. See assets.go: a
			// self-hosted admin console that fetches its own JavaScript from a
			// third party is dead without egress, leaks its usage, and puts a
			// remote host inside the page that mints API tokens.
			<script type="module" src="/admin/assets/datastar.js"></script>
			<link rel="stylesheet" href={ stylesheetHref() }/>
		</head>
		<body data-signals={ signals }>
			<a class="skip" href="#main">Skip to content</a>
			<header>
				<h1>ocr-router</h1>
				<nav aria-label="Sections">
					<a href="/admin">Overview</a>
					<a href="/admin/users">Customers</a>
					<a href="/admin/services">Services</a>
				</nav>
			</header>
			<main id="main">
				{ children... }
			</main>
		</body>
	</html>
}
