package views

// Login is the dashboard's sign-in page.
//
// ⚠ IT USES A PLAIN <form method="post">, NOT DATASTAR, and that is a decision
// rather than an oversight. Every other view in this package binds inputs to
// datastar signals, and two things make that wrong here:
//
//   - Datastar signals are GLOBAL and every unprefixed one is sent to the
//     backend on every action. A password in a signal is a password sitting in
//     the page's reactive state for as long as the tab is open.
//   - A native form POST works with no JavaScript at all. The one page a locked-
//     out operator needs is the one that should depend on the least.
//
// It also deliberately does not use Layout: that shell renders navigation to
// authenticated pages, and offering links that 401 to someone who has not logged
// in yet is a worse first impression than a page with nothing on it.
templ Login(errMsg string, requireTLS bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in — ocr-router</title>
			<link rel="stylesheet" href={ stylesheetHref() }/>
		</head>
		<body>
			<main id="main" class="login-wrap">
				<div class="login-card">
					<h1>ocr-router</h1>
					<p class="muted">Administrator sign-in</p>
					if requireTLS {
						<p class="login-error" role="alert">
							This page is being served over plain HTTP. The session cookie is
							marked Secure, so a browser would discard it and the sign-in would
							appear to succeed and then fail. Put TLS in front of the router
							before signing in.
						</p>
					} else {
						if errMsg != "" {
							<p class="login-error" role="alert">{ errMsg }</p>
						}
						<form method="post" action="/admin/login">
							<div class="field">
								<label for="email">Email</label>
								<input
									id="email"
									name="email"
									type="email"
									autocomplete="username"
									required
									autofocus
								/>
							</div>
							<div class="field">
								<label for="password">Password</label>
								<input
									id="password"
									name="password"
									type="password"
									autocomplete="current-password"
									required
								/>
							</div>
							<button type="submit">Sign in</button>
						</form>
					}
					<p class="muted login-hint">
						Sessions last 12 hours and are not extended by use. Signing out ends
						the session everywhere, including other tabs.
					</p>
				</div>
			</main>
		</body>
	</html>
}

// The login page's own rules live in assets/app.css alongside the dashboard's,
// under the .login-* prefix. They were briefly a second Go constant here, which
// had the same defect as the main stylesheet: templ does not interpolate inside
// <style>, so both were rendering as literal text.
